# Copy to .env for LOCAL development only. Production values belong in hosting secrets.
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017/tumorong
# Generate a unique random value with at least 32 characters; never commit a real value.
SESSION_SECRET=
ADMIN_ALLOWED_ORIGINS=https://miniapp.tumorong.com
# Render HTTPS reverse proxy: verify one trusted proxy before setting this to 1.
TRUST_PROXY_HOPS=0
# Keep the admin UI and API on the same origin for session cookies.
VITE_API_URL=
ZALO_SECRET_KEY=
ZALO_PRIVATE_KEY=
GHN_TOKEN=
GHN_SHOP_ID=
GEMINI_API_KEY=
# Development-only test accounts; ignored in production.
TEST_PHONES=
# Optional AppSheet bridge (server-only).
APPSHEET_SYNC_ENABLED=false
APPSHEET_SPREADSHEET_ID=
APPSHEET_SERVICE_ACCOUNT_EMAIL=
APPSHEET_PRIVATE_KEY=
